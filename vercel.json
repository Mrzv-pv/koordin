{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "node build.js",
  "outputDirectory": "dist",

  "cleanUrls": false,
  "trailingSlash": false,

  "redirects": [
    {
      "source": "/legalhelp.html",
      "destination": "/wiki.html",
      "permanent": true
    },
    {
      "source": "/legalhelp",
      "destination": "/wiki.html",
      "permanent": true
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "_comment": "У styles.*.css и site.*.js в имени хеш содержимого, поэтому вечный кеш безопасен: новая сборка ссылается на новое имя.",
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "_comment": "Имена картинок без хеша — срок короче. Правило идёт последним, поэтому перекрывает общее.",
      "source": "/assets/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
